@1180 = ~La tua anima è il mio potere.~ [AC#WNIH1] // soundset Megera della Notte
@1181 = ~Sogna un piccolo sogno di me, mortale!~ [AC#WNIH2] // soundset Megera della Notte
@1182 = ~Io sono potere, piacere e perdizione.~ [AC#WMAR1] // soundset Maretta
@1183 = ~Benvenuto nel regno della disperazione, dove non esiste conforto, mortale. Sono Maretta, signora di Samora.~ [AC#WMAR2] ~Benvenuta nel regno della disperazione, dove non esiste conforto, mortale. Sono Maretta, signora di Samora.~ [AC#WMAR2] // soundset Maretta
@1184 = ~Ammira la mia bellezza o sparisci.~ [AC#WMAR3] // soundset Maretta
@1186 = ~Salute, mortali.~ [AC#WMEF1] // primo incontro con Mefisto
@1187 = ~Salute, mortali.~ [AC#WMEF1] //[AC#WMEF2] Mefisto#2, da modificare in seguito
@1188 = ~Oh, di nuovo voi.~ [AC#WMEF3] // Mefisto
@1190 = ~Il denaro parla. La ricchezza canta.~ [AC#WTHA2] // Tharundar Olehm
@1191 = ~Buoni affari.~ [AC#WTHA5] // Tharundar Olehm
@1195 = ~Salute. Sono Kyriani Agrivar, sacerdotessa di Selûne, da Waterdeep.~ [AC#WKYR1]

@1210 = ~Fermo, mortale!~ [AC#WBAB2] ~Ferma, mortale!~ [AC#WBAB2] 
@1211 = ~Un esercito marcia sui suoi mortali!~ [AC#WBAB1]
@1212 = ~Sono di pessimo, pessimo umore.~ [AC#WDEM1]
@1213 = ~I miei prezzi sono i migliori a sud di Hellhole.~ [AC#WMER1]
@1214 = ~La mia taverna è sporca come il culo di un diavolo.~ [AC#WSOL1]
@1215 = ~Temimi, poiché ti confondo.~ [AC#WDEM2]
@1216 = ~In questo gioco di anime, la legge vince sempre.~ [AC#WAPH1]
@1217 = ~Ho un sacco di merci ripugnanti!~ [AC#WMER2]
@1218 = ~Sono gloriosamente glorioso!~ [AC#W75S1]
@1219 = ~Colpiscimi più forte che puoi!~ [AC#W74W3]
@1220 = ~Fatti avanti e scatena la tua ira.~ [AC#W74W4]
@1221 = ~Mostra la tua furia e fa' vedere la tua forza.~ [AC#W74W5]
@1222 = ~Meglio una scoreggia d'un immondo che una freccia da tergo.~ [AC#WDWR1]
@1223 = ~Così tanti strati, così tanto da imparare.~ [AC#WDWR2]
@1224 = ~Per la gloria di Baator!~ [AC#WAPH2]
@1225 = ~Quaggiù la magia non è un semplice gioco da salotto.~ [AC#WMSV1]
@1226 = ~Non puoi lanciare magie come lanci carte.~ [AC#WMSV2]
@1227 = ~Fate largo, spilungoni!~ [AC#WSQRL]

@1230 = ~Sono la dea della ricchezza. Sì, proprio io!~ [AC#WWAE0]
@1240 = ~Perché usare il proprio potere quando si può far sprecare agli altri il loro?~ [AC#WVER0]

@1250 = ~Chi calpesta la mia tela?~ [AC#WBEB0]
@1251 = ~Assaggia il mio morso velenoso!~ [AC#WBEB2]

@1255 = ~Guarda dove metti i piedi.~ [AC#WLIL1]
@1256 = ~La luce della luna guida il mio cammino.~ [AC#WLIL2]

@1260 = ~Ahhh... così buio...~ [AC#WHALA]

@1270 = ~Ti salutiamo, creatura di carne.~ [AC#WMONA]
@1271 = ~Un occhio, una direzione.~ [AC#WMON0]
@1272 = ~Rilevato soggetto ostile dalla mente univoca...~ [AC#WMONB]
@1273 = ~Non esiste individuo migliore di noi.~ [AC#WMONC]
@1274 = ~Pensiamo come uno.~ [AC#WMOND]
@1275 = ~Un semplice colpo contro tutti noi.~ [AC#WMONE]
@1276 = ~Abbandono della comunità mentale...~ [AC#WMONF]

@1280 = ~Io malvagio.~ [AC#WBAP1]
@1281 = ~Io forte. Tu debole!~ [AC#WBAP2]

@1285 = ~Destino o no, non resterò a lungo in questo luogo.~ [AC#WNYS1]
@1286 = ~Devo essere libera.~ [AC#WNYS2]

@1290 = ~~ [AM1900B1]

@1300 = ~Che ricchezze e prosperità accompagnino ogni tuo passo.~ [AC#WWAUX]

// soundset mercenari Guerra Sanguinosa
@1311 = ~Sia fatta la volontà degli Inferi!~ [AC#W60M1]
@1312 = ~Per la gloria di Baator!~ [AC#W60M2]
@1313 = ~Per la gerarchia!~ [AC#W60M3]
@1314 = ~Comanda la potenza infernale!~ [AC#W60M4]

@1320 = ~Nessuna buona azione resta impunita!~ [AC#W4CF1]
@1330 = ~Mi hai chiamato e ho risposto. Insieme apriremo un sentiero di devastazione attraverso queste terre!~

// file ARE
@3000 = ~Da questa porta emana una luce abbagliante, incredibilmente intensa. Sebbene il bagliore non sembri maligno, capisci che la sua intensità ti distruggerebbe se entrassi nell'area al di là della porta.~
@3001 = ~Gilda dei Viaggiatori dei Piani~
@3002 = ~Torna ai piedi della Scala~
@3003 = ~Portale per l'Abisso~
@3004 = ~Macchina Modron~
@3005 = ~Questa statua raffigura la dea Waukeen. Sembra realizzata in oro puro.~
@3006 = ~Da questa finestra a bovindo puoi osservare il viavai dell'abbazia.~
@3007 = ~Torna a Faerûn~
@3008 = ~Inizio della Scala Infinita~
@3009 = ~Elandra Moonsong~
@3010 = ~Questa porta sembra scendere dalla torre al tempio. È chiusa dall'altro lato e, a giudicare dagli sguardi delle guardie, forzarla non sarebbe una buona idea.~
@3011 = ~Un piedistallo di cristallo blu~
@3012 = ~Un piedistallo di cristallo verde~
@3013 = ~Un piedistallo di cristallo rosso~
@3014 = ~Un piedistallo di cristallo giallo~

