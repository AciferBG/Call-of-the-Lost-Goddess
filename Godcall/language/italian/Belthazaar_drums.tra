@0 = ~Salve, alti mortali!~
@1 = ~Credevo di evocare un glabrezu, non un misero quasit!~
@2 = ~Evoca Belthazaar il glabrezu.~
@3 = ~Pazienza, pazienza, <RACE>! Belthazaar il glabrezu arriverà. Mi hanno solo mandato avanti a controllare che la via sia libera!~
@4 = ~Allora evoca il glabrezu.~
@5 = ~Hmm... fammi dare un'occhiata in giro...~
@6 = ~Non è ancora il momento! Non devi essere così impaziente!~
@7 = ~Sembra tutto a posto! Il mio padrone sarà qui da un momento all'altro, preparatevi!~
@8 = ~Basta parlare, combatti!~
@9 = ~Il mio padrone non può essere evocato qui nell'Abisso, ma solo sul Primo Piano Materiale, stolti!~
