@0 = ~Salut, les grands mortels !~
@1 = ~Je croyais invoquer un Glabrezu, pas un minable Quasit ?~
@2 = ~Invoque le Glabrezu Belthazaar.~
@3 = ~Patience, patience, <RACE> ! Belthazaar, le Glabrezu, arrive. On m'a seulement envoyé en éclaireur pour vérifier que la voie est libre !~
@4 = ~Alors invoque le Glabrezu.~
@5 = ~Hmm... laissez-moi jeter un coup d'œil aux alentours...~
@6 = ~Le temps n'est pas encore écoulé ! Il ne faut pas être si impatient !~
@7 = ~Tout a l'air en ordre ! Mon maître sera là d'un instant à l'autre. Préparez-vous !~
@8 = ~Ne parle pas, bats-toi !~
@9 = ~Mon maître ne peut pas être invoqué ici, dans les Abysses, mais seulement sur le Plan matériel, bande d'imbéciles !~
