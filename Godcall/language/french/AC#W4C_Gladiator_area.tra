@0 = ~Le champion de Samora est dans l'arène ! Qui veut affronter <PRO_HIMHER> ?~
@1 = ~...~
@2 = ~Malheureusement, personne ne veut se mesurer à vous. Dégagez, vous faites fuir mes clients !~
@3 = ~Vous l'avez vaincu ! Vous avez vraiment vaincu le champion !~
@4 = ~Je n'aurais jamais cru qu'un misérable mortel puisse y parvenir. Très bien, vous avez gagné mon respect. Et une récompense. Allez au « Solaire détrempé » et buvez tout votre soûl.~
@5 = ~Vous avez vaincu presque tous mes gladiateurs. Il n'en reste plus qu'un. Si vous le battez, vous pourrez fièrement porter le titre de « Champion des gladiateurs de Samora ».~
@6 = ~Qui est le dernier combattant ?~
@7 = ~J'ose relever ce dernier défi !~
@8 = ~Cela ne m'intéresse pas.~
@9 = ~Le dernier guerrier est un combattant très expérimenté. Jadis serviteur du bien, il s'est finalement écarté de cette voie et a fini ici. C'est un Aasimon, une créature rayonnante aux magnifiques ailes et à la peau délicate. Enfin, c'est ce qu'il était avant d'écraser tous ses adversaires en morceaux. Alors ? Voulez-vous affronter l'ancien champion ?~
@10 = ~Excellent ! Les gars ! Il y a un combat ! Venez voir ce mortel se faire réduire en lambeaux par son adversaire !~
@11 = ~Hé, rares sont les gladiateurs capables d'abattre ainsi un mercenaire Yugoloth. Je commence à manquer d'adversaires !~
@12 = ~On dirait que vous avez l'habitude de ces grands yeux globuleux dans votre monde. Bien joué, combattant ! Mes invités ont été bien divertis.~
@13 = ~Ça se corse, n'est-ce pas ? Les frères Tieffelins étaient jusqu'ici considérés comme les candidats les plus prometteurs de ces fosses. Ce statut est maintenant le vôtre ! Voyons pour combien de temps...~
@14 = ~Vous avez montré à ces singes de quel bois vous vous chauffez ! Aucun regret : c'étaient de toute façon des serviteurs de notre ennemi Démogorgon...~
@15 = ~Vous avez vaincu un baron Cambion ! Pas mal, pas mal ! On peut parier que son fier père Balor ne sera pas ravi d'avoir perdu son fils.~
@16 = ~Bien, vous avez vaincu les serviteurs du Cornu ! Voyons maintenant comment vous vous en sortirez face au prochain adversaire !~
@17 = ~Des Dretches ! Comme je déteste ces bâtards puants ! Heureusement que vous leur avez montré qui commande dans cette arène !~
@18 = ~Ces Tanarukks n'étaient probablement pas un défi extraordinaire pour vous. Un butin facilement gagné, je dirais !~
@19 = ~Eh bien, ce n'était pas trop mal pour commencer ! Revenez me parler lorsque vous serez prêt pour le prochain tour. Mais attention : les adversaires seront de plus en plus coriaces !~
@20 = ~De la viande fraîche pour l'arène ! Mesurerez-vous votre force à celle de vos adversaires pour remporter une victoire glorieuse... ou périr misérablement ?~
@21 = ~Quel est cet endroit ?~
@22 = ~J'ose combattre !~
@23 = ~Quelles sont les règles ?~
@24 = ~Ici ? Ce sont les Fosses de la Corruption. Les gladiateurs s'y affrontent pour récolter gloire et fortune !~
@25 = ~Des règles ? Quelles règles ? Vous vous battez à mort ! Le combat s'achève lorsque tous vos adversaires sont morts. Il n'y a pas de récompense : le butin de vos ennemis suffit amplement.~
@26 = ~Alors sortez de mon arène, mortels !~
@27 = ~Prêts à combattre ?~
