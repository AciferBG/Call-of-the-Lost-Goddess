@0 = ~Salut à toi, mortel. Je vois bien tes yeux qui ne tiennent pas en place. « Qu'est-ce que j'ai à gagner ici ? » te demandes-tu ! « Qu'est-ce que je peux tirer de cette salle ? » Eh bien, j'ai une offre généreuse à te faire, alors écoute attentivement.~ [OGREM01.WAV]
@1 = ~Tu vois ce vieil homme décrépit à côté de moi ? Inutile d'essayer de lui parler. Je lui ai coupé la langue, et il ne peut pas davantage t'entendre. Mais il possède quelque chose que tu pourrais t'approprier : un anneau magique, vraiment puissant. C'est le seul bien de valeur auquel il tienne encore dans cet endroit misérable ! Mais pourquoi s'y accroche-t-il ? Cet anneau pourrait être à toi. Il est destiné à t'appartenir !~
@2 = ~Pourquoi ne pas t'en emparer ? Mettre fin à la vie de cet homme, ici et maintenant, serait si facile. Aucun témoin, personne pour le pleurer. Et alors, ce puissant anneau magique serait à toi, un atout précieux pour tes prochaines aventures dans les Abysses !~
@3 = ~Une tentative maladroite pour éveiller l'envie chez un mortel, rien de plus. J'aurais attendu mieux d'un démon dans un tel endroit.~
@4 = ~Pourquoi un vieillard posséderait-il un objet aussi puissant ? Ce ne sont que des mensonges destinés à nous déstabiliser.~
@5 = ~Tu n'espères tout de même pas me faire croire, démon, que moi, paladin, je laisserais qui que ce soit accorder plus de valeur à un anneau qu'à la vie d'un homme ! Va-t'en, et emporte tes intentions malveillantes avec toi.~
@6 = ~Je suis censé tuer quelqu'un pour m'enrichir de ses biens ? Jamais de la vie !~
@7 = ~Je ne sais pas...~
@8 = ~Comment savoir que tu n'essaies pas de me tromper ?~
@9 = ~Tu as raison ! Ce serait dommage que cet anneau reste entre les mains d'un être aussi vieux et fragile !~
@10 = ~Tu l'as fait ! Tu l'as vraiment fait ! Fabuleux ! Tu as réussi l'épreuve, la sortie t'est ouverte. Ma mission ici est donc terminée, et je vais prendre congé...~
@11 = ~Pourquoi ferais-je cela ? Ma tâche consiste à détourner les mortels de la voie de la vertu naïve, pas à les tromper.~
@12 = ~Aucune vie ne mérite d'être ôtée pour un anneau !~
@13 = ~Très bien, je vais tuer cet homme et prendre l'anneau.~
@14 = ~Qu'est-ce que tu fabriques ? Tue le vieil homme, prends l'anneau, il devrait être à toi !~ //[OGREM01.WAV]
@15 = ~Je ne tuerai personne pour un anneau !~
@16 = ~Alors, qu'en dis-tu ? As-tu examiné l'anneau de près ? As-tu mesuré sa puissance et l'attrait éblouissant qu'il dégage ? Imagine à quel point il pourrait accroître tes propres capacités. Quel dommage qu'il faille maintenant le rendre à son propriétaire illégitime...~ //[OGREM01.WAV]
@17 = ~Ou bien souhaites-tu le garder ?~
@18 = ~Reprends cet anneau maudit, je n'en veux pas !~
@19 = ~En fait, je n'ai aucune intention de le rendre.~
@20 = ~Quel dommage. Quoi qu'il en soit, la sortie t'est ouverte. Je vais prendre la vie du vieil homme et partir. Quant à toi, il te faudra composer avec tes propres désirs rongés par l'envie.~
@21 = ~Une sage décision ! L'envie est le plus beau de tous les mauvais penchants, car elle récompense aussitôt ceux qui y cèdent, souviens-t'en. Tu as réussi l'épreuve, la sortie t'est ouverte. Garde l'anneau ; moi, je vais prendre la vie du vieil homme et partir...~
@22 = ~Oh, tu ne l'as plus ! Je suppose que tu l'as caché ? Laissé tomber pour pouvoir le ramasser plus tard ? Quelle ingéniosité pour un <PRO_RACE> ! Tout mon respect. Eh bien, tu as réussi l'épreuve, la sortie t'est ouverte. Adieu. Je n'ai plus besoin du vieil homme. Je pourrai toujours en trouver un autre...~
@23 = ~Eh bien, alors ? As-tu réfléchi ?~
@24 = ~Contemple cet anneau, mortel ! Ne ressens-tu pas son pouvoir envoûtant ? Imagine avec quelle facilité tu pourrais triompher au combat si tu l'avais en ta possession.~
@25 = ~L'homme va te prêter temporairement l'anneau. Examine-le bien avant qu'il ne te le réclame...~
@26 = ~Non, garde l'anneau, je n'en veux pas !~
@27 = ~Je peux toujours y jeter un coup d'œil...~
@28 = ~Oui, oui, un rapide coup d'œil ne peut pas faire de mal. Mais dépêche-toi, car tu devras rendre l'anneau sous peu...~
@29 = ~Alors dépêche-toi avant que quelqu'un d'autre ne s'empare de l'anneau !~
