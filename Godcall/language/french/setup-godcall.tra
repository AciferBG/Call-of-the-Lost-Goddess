@1180 = ~Ton âme nourrit ma puissance.~ [AC#WNIH1] // Nighthag soundset
@1181 = ~Fais de beaux rêves de moi, mortel !~ [AC#WNIH2]  // Nighthag soundset
@1182 = ~Je suis puissance, plaisir et perdition.~ [AC#WMAR1] // Maretta soundset
@1183 = ~Bienvenue au royaume du désespoir, où nul réconfort ne t'attend, mortel. Je suis Maretta, maîtresse de Samora.~ [AC#WMAR2] // Maretta soundset
@1184 = ~Contemple ma beauté ou disparais.~ [AC#WMAR3] // Maretta soundset
@1186 = ~Salutations, mortels.~ [AC#WMEF1] // Mefisto initial meeting
@1187 = ~Salutations, mortels.~ [AC#WMEF1] //[AC#WMEF2] Mefisto#2, need to change later
@1188 = ~Oh, encore vous.~ [AC#WMEF3] // Mefisto
@1190 = ~L'argent parle. La richesse chante.~ [AC#WTHA2] // Tharundar Olehm
@1191 = ~Bonnes affaires.~ [AC#WTHA5] // Tharundar Olehm
@1195 = ~Salutations. Je suis Kyriani Agrivar, prêtresse de Séluné venue de Eauprofonde.~ [AC#WKYR1]

@1210 = ~Ne bouge plus, mortel !~ [AC#WBAB2]
@1211 = ~Une armée marche grâce à ses mortels !~ [AC#WBAB1]
@1212 = ~Je suis de très, très mauvaise humeur.~ [AC#WDEM1]
@1213 = ~Mes prix sont les meilleurs au sud du Trou de l'Enfer.~ [AC#WMER1]
@1214 = ~Ma taverne est aussi sale que le cul d'un diable.~ [AC#WSOL1]
@1215 = ~Crains-moi, car je brouille ton esprit.~ [AC#WDEM2]
@1216 = ~Dans ce jeu d'âmes, la loi finit toujours par gagner.~ [AC#WAPH1]
@1217 = ~J'ai quantité de marchandises abjectes !~ [AC#WMER2]
@1218 = ~Je suis glorieusement glorieux !~ [AC#W75S1]
@1219 = ~Vas-y, donne-moi ton meilleur coup !~ [AC#W74W3]
@1220 = ~Avance et déchaîne ta colère.~ [AC#W74W4]
@1221 = ~Révèle ta rage et montre ta puissance.~ [AC#W74W5]
@1222 = ~Mieux vaut le pet d'un fiélon qu'un trait dans le dos.~ [AC#WDWR1]
@1223 = ~Tant de strates, tant de choses à apprendre.~ [AC#WDWR2]
@1224 = ~Pour la gloire de Baator !~ [AC#WAPH2]
@1225 = ~Ici-bas, la magie n'est pas un simple tour de salon.~ [AC#WMSV1]
@1226 = ~On ne lance pas la magie comme on lance des cartes.~ [AC#WMSV2]
@1227 = ~Place, les grands !~ [AC#WSQRL]

@1230 = ~Je suis la déesse de la richesse. Oui, parfaitement !~ [AC#WWAE0]
@1240 = ~Pourquoi gaspiller sa propre puissance quand on peut forcer les autres à gaspiller la leur ?~ [AC#WVER0]


@1250 = ~Qui marche sur ma toile ?~ [AC#WBEB0]
@1251 = ~Goûte à ma morsure empoisonnée !~ [AC#WBEB2]

@1255 = ~Regardez où vous mettez les pieds.~ [AC#WLIL1]
@1256 = ~Le clair de lune guide mes pas.~ [AC#WLIL2]

@1260 = ~Aah... si sombre...~ [AC#WHALA]

@1270 = ~Nous te saluons, être de chair.~ [AC#WMONA]
@1271 = ~Un œil, une direction.~ [AC#WMON0]
@1272 = ~Sujet hostile à l'esprit borné détecté...~ [AC#WMONB]
@1273 = ~Il n'existe pas de meilleur individu que nous.~ [AC#WMONC]
@1274 = ~Nous pensons comme un seul être.~ [AC#WMOND]
@1275 = ~Un simple coup contre nous tous.~ [AC#WMONE]
@1276 = ~Déconnexion de la communauté mentale...~ [AC#WMONF]

@1280 = ~Moi méchant.~ [AC#WBAP1]
@1281 = ~Moi fort. Toi faible !~ [AC#WBAP2]

@1285 = ~Destin ou pas, je ne resterai plus longtemps ici.~ [AC#WNYS1]
@1286 = ~Je dois être libre.~ [AC#WNYS2]

@1290 = ~~ [AM1900B1]

@1300 = ~Puissent richesse et prospérité accompagner chacun de vos pas.~ [AC#WWAUX]

// Blood war merc soundsets
@1311 = ~Que la volonté des Enfers soit faite !~ [AC#W60M1]
@1312 = ~Pour la gloire de Baator !~ [AC#W60M2]
@1313 = ~Pour la hiérarchie !~ [AC#W60M3]
@1314 = ~La puissance infernale commande !~ [AC#W60M4]

@1320 = ~Aucune bonne action ne reste impunie !~ [AC#W4CF1]

@1330 = ~Tu as appelé, j'ai répondu. Traçons ensemble un chemin de dévastation à travers ces terres !~
// #2000: items

// are files
@3000 = ~Une lumière éblouissante, incroyablement vive, émane de cette porte. Bien qu'elle ne paraisse pas malveillante, vous comprenez que son intensité vous détruirait si vous pénétriez dans la zone située au-delà.~
